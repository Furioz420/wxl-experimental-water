enable_language(RC)
set(VFOG_ROOT "${wxl_ext_dir}/vendor/coa-vfog")
set(VFOG_SHADER_OUT "${CMAKE_CURRENT_BINARY_DIR}/vfog-shaders")
file(MAKE_DIRECTORY "${VFOG_SHADER_OUT}")
file(GLOB VFOG_FXC "$ENV{ProgramFiles\(x86\)}/Windows Kits/10/bin/10.*/x86/fxc.exe")
if(NOT VFOG_FXC)
    message(FATAL_ERROR "The Windows SDK x86 fxc shader compiler is required for vfog")
endif()
list(SORT VFOG_FXC COMPARE NATURAL ORDER DESCENDING)
list(GET VFOG_FXC 0 VFOG_FXC)
file(GLOB VFOG_INCLUDES "${VFOG_ROOT}/shaders/*.hlsli")
function(wxl_vfog_shader name source profile)
    set(out "${VFOG_SHADER_OUT}/${name}.h")
    add_custom_command(OUTPUT "${out}"
        COMMAND "${VFOG_FXC}" /nologo /O3 /T ${profile} /E main /Vn g_${name} ${ARGN}
            /Fh "${out}" "${VFOG_ROOT}/shaders/${source}"
        DEPENDS "${VFOG_ROOT}/shaders/${source}" ${VFOG_INCLUDES} VERBATIM)
    target_sources(${wxl_ext_name} PRIVATE "${out}")
endfunction()
wxl_vfog_shader(vs_fullscreen vf_fullscreen_vs.hlsl vs_3_0)
foreach(quality low mid high)
    if(quality STREQUAL low)
        set(steps 16)
    elseif(quality STREQUAL mid)
        set(steps 24)
    else()
        set(steps 32)
    endif()
    foreach(pass march composite)
        wxl_vfog_shader(ps_${pass}_${quality} vf_${pass}.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=0)
        wxl_vfog_shader(ps_lit_${pass}_${quality} vf_${pass}.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=1)
        wxl_vfog_shader(ps_noisy_${pass}_${quality} vf_${pass}.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=0 /DSAMPLES_AUTHORED_NOISE=1)
    endforeach()
    wxl_vfog_shader(ps_lit_noisy_march_${quality} vf_march.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=1 /DSAMPLES_AUTHORED_NOISE=1)
    wxl_vfog_shader(ps_split_composite_${quality} vf_composite_split.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=0)
    wxl_vfog_shader(ps_lit_split_composite_${quality} vf_composite_split.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=1)
    wxl_vfog_shader(ps_noisy_split_composite_${quality} vf_composite_split.hlsl ps_3_0 /DSTEPS=${steps} /DLOCAL_LIGHTS=0 /DSAMPLES_AUTHORED_NOISE=1)
endforeach()
foreach(pass temporal history_depth ray_mask ray_blur probe depth_check)
    wxl_vfog_shader(ps_${pass} vf_${pass}.hlsl ps_3_0)
endforeach()
wxl_vfog_shader(ps_silhouette_mask vf_silhouette_mask.hlsl ps_3_0 /DLOCAL_LIGHTS=0)
wxl_vfog_shader(ps_ray_composite vf_ray_composite.hlsl ps_3_0 /DSTEPS=16 /DLOCAL_LIGHTS=0)
wxl_vfog_shader(ps_vw_ripple_step vw_ripple_step.hlsl ps_3_0)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/vfog-data.rc"
    "9101 RCDATA \"${VFOG_ROOT}/data/fogdata.bin\"\n9102 RCDATA \"${VFOG_ROOT}/data/waterdata.bin\"\n")
target_sources(${wxl_ext_name} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/vfog-data.rc")
set_source_files_properties("${CMAKE_CURRENT_BINARY_DIR}/vfog-data.rc" PROPERTIES
    OBJECT_DEPENDS "${VFOG_ROOT}/data/fogdata.bin;${VFOG_ROOT}/data/waterdata.bin")
target_include_directories(${wxl_ext_name} PRIVATE "${VFOG_ROOT}/src" "${VFOG_SHADER_OUT}")

wxl_vfog_shader(ps_vw_depth vw_linear_depth.hlsl ps_3_0 /DPACKED_DEPTH=0)
wxl_vfog_shader(ps_vw_depth_packed vw_linear_depth.hlsl ps_3_0 /DPACKED_DEPTH=1)
wxl_vfog_shader(ps_vw_shade_low vw_water.hlsl ps_3_0 /DSSR_STEPS=0)
wxl_vfog_shader(ps_vw_shade_mid vw_water.hlsl ps_3_0 /DSSR_STEPS=16)
wxl_vfog_shader(ps_vw_shade_high vw_water.hlsl ps_3_0 /DSSR_STEPS=32)

wxl_vfog_shader(ps_vw_fft_evolve vw_fft_evolve.hlsl ps_3_0)
wxl_vfog_shader(ps_vw_fft_rows vw_fft_butterfly.hlsl ps_3_0 /DCOLUMNS=0 /DFUSED_STAGES=0 /DASSEMBLE=0)
wxl_vfog_shader(ps_vw_fft_rows_fused vw_fft_butterfly.hlsl ps_3_0 /DCOLUMNS=0 /DFUSED_STAGES=1 /DASSEMBLE=0)
wxl_vfog_shader(ps_vw_fft_columns vw_fft_butterfly.hlsl ps_3_0 /DCOLUMNS=1 /DFUSED_STAGES=0 /DASSEMBLE=0)
wxl_vfog_shader(ps_vw_fft_columns_fused vw_fft_butterfly.hlsl ps_3_0 /DCOLUMNS=1 /DFUSED_STAGES=1 /DASSEMBLE=0)
wxl_vfog_shader(ps_vw_fft_assemble_fused vw_fft_butterfly.hlsl ps_3_0 /DCOLUMNS=1 /DFUSED_STAGES=1 /DASSEMBLE=1)
wxl_vfog_shader(ps_vw_fft_surface_foam vw_fft_surface.hlsl ps_3_0 /DSURFACE=1 /DFOAM=1)
wxl_vfog_shader(ps_vw_fft_surface vw_fft_surface.hlsl ps_3_0 /DSURFACE=1 /DFOAM=0)
wxl_vfog_shader(ps_vw_fft_foam vw_fft_surface.hlsl ps_3_0 /DSURFACE=0 /DFOAM=1)
wxl_vfog_shader(ps_vw_fft_mip vw_fft_mip.hlsl ps_3_0 /DPAIRED=0)
wxl_vfog_shader(ps_vw_fft_mip_pair vw_fft_mip.hlsl ps_3_0 /DPAIRED=1)
